{
  "apiVersion": "orion/v1",
  "project": "etl-cms-ohdsi",
  "platform": "databricks",
  "runtime": {
    "languages": [
      {
        "language": "Python",
        "version": "3.9"
      },
      {
        "language": "SQL",
        "version": "Spark SQL"
      }
    ],
    "orchestrator": "databricks_jobs",
    "workspace_url": "https://dbc-1234.cloud.databricks.com"
  },
  "unity_catalog": {
    "catalog": "etl_cms",
    "schema": "ohdsi_cdm",
    "volume": "ohdsi_volume",
    "ddl_files": [
      "create_CDMv5_tables.sql",
      "load_CDMv5_synpuf.sql"
    ],
    "gold_tables": [
      "concept",
      "vocabulary",
      "domain",
      "concept_class",
      "concept_relationship",
      "relationship",
      "concept_synonym",
      "concept_ancestor",
      "source_to_concept_map",
      "drug_strength",
      "cohort_definition",
      "attribute_definition",
      "cdm_source",
      "person",
      "observation_period",
      "specimen",
      "death",
      "visit_occurrence",
      "procedure_occurrence",
      "drug_exposure",
      "device_exposure",
      "condition_occurrence",
      "measurement_occurrence",
      "note",
      "observation",
      "fact_relationship",
      "location",
      "care_site",
      "provider",
      "payer_plan_period",
      "visit_cost",
      "procedure_cost",
      "drug_cost",
      "device_cost",
      "cohort",
      "cohort_attribute",
      "drug_era",
      "dose_era",
      "condition_era"
    ]
  },
  "stages": [
    {
      "name": "get_raw_files",
      "layer": "bronze",
      "sources": [
        {
          "data_upload_type": "manual",
          "subfolder_name": "omop_vocabulary",
          "files": [
            "Initialize_Procedures_2026-09-08-1702.csv"
          ]
        },
        {
          "data_upload_type": "custom_script",
          "subfolder_name": "synpuf_raw",
          "scripts": [
            {
              "file": "get_synpuf_files.py",
              "parameters": [
                "all"
              ]
            }
          ]
        }
      ],
      "scripts": "scripts_default",
      "destination": {
        "type": "volume"
      }
    },
    {
      "name": "map_omop_datamodel",
      "layer": "silver",
      "sources": [
        {
          "data_upload_type": "auto",
          "from": "bronze"
        }
      ],
      "scripts": [
        {
          "file": "CMS_SynPuf_ETL_CDM_v5.py",
          "path": "src/CMS_SynPuf_ETL_CDM_v5.py",
          "parameters": [
            "1"
          ]
        }
      ],
      "destination": {
        "type": "volume",
        "subfolder_name": "silver_output"
      }
    },
    {
      "name": "gold",
      "layer": "gold",
      "sources": [
        {
          "data_upload_type": "auto",
          "from": "silver"
        }
      ],
      "scripts": "scripts_default",
      "destination": {
        "type": "tables",
        "catalog": "etl_cms",
        "schema": "ohdsi_cdm",
        "tables": [
          "concept",
          "vocabulary",
          "domain",
          "concept_class",
          "concept_relationship",
          "relationship",
          "concept_synonym",
          "concept_ancestor",
          "source_to_concept_map",
          "drug_strength",
          "cohort_definition",
          "attribute_definition",
          "cdm_source",
          "person",
          "observation_period",
          "specimen",
          "death",
          "visit_occurrence",
          "procedure_occurrence",
          "drug_exposure",
          "device_exposure",
          "condition_occurrence",
          "measurement_occurrence",
          "note",
          "observation",
          "fact_relationship",
          "location",
          "care_site",
          "provider",
          "payer_plan_period",
          "visit_cost",
          "procedure_cost",
          "drug_cost",
          "device_cost",
          "cohort",
          "cohort_attribute",
          "drug_era",
          "dose_era",
          "condition_era"
        ]
      }
    }
  ],
  "generated": "2026-10-09"
}