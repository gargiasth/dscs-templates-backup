{
  "apiVersion": "orion/v1",
  "project": "etl_cms_ohdsi_test",
  "platform": "databricks",
  "runtime": {
    "languages": [
      {
        "language": "Python",
        "version": "3.9"
      },
      {
        "language": "SQL",
        "version": "Spark SQL"
      }
    ],
    "orchestrator": "databricks_jobs",
    "workspace_url": "https://1234.cloud.databricks.com"
  },
  "unity_catalog": {
    "catalog": "etl_cms_test",
    "schema": "ohdsi_cdm_test",
    "volume": "ohdsi_volume_test",
    "ddl_files": [
      "src/CMS SynPUF ETL/SQL/create_CDMv5_tables.sql"
    ],
    "gold_tables": [
      "concept",
      "vocabulary",
      "domain",
      "concept_class",
      "concept_relationship",
      "relationship",
      "concept_synonym",
      "concept_ancestor",
      "source_to_concept_map",
      "drug_strength",
      "cohort_definition",
      "attribute_definition",
      "cdm_source",
      "person",
      "observation_period",
      "specimen",
      "death",
      "visit_occurrence",
      "procedure_occurrence",
      "drug_exposure",
      "device_exposure",
      "condition_occurrence",
      "measurement_occurrence",
      "note",
      "observation",
      "fact_relationship",
      "location",
      "care_site",
      "provider",
      "payer_plan_period",
      "visit_cost",
      "procedure_cost",
      "drug_cost",
      "device_cost",
      "cohort",
      "cohort_attribute",
      "drug_era",
      "dose_era",
      "condition_era"
    ],
    "folders": [
      {
        "volume": "ohdsi_volume_test",
        "subfolder": "omopt_tables"
      },
      {
        "volume": "ohdsi_volume_test",
        "subfolder": "control"
      }
    ]
  },
  "stages": [
    {
      "name": "table_setup",
      "layer": "bronze",
      "sources": [],
      "entry_point": {
        "file": "create_CDMv5_tables.sql",
        "path": "src/CMS SynPUF ETL/SQL/create_CDMv5_tables.sql",
        "parameters": []
      },
      "destination": {
        "type": "tables",
        "catalog": "etl_cms_test",
        "schema": "ohdsi_cdm_test"
      }
    },
    {
      "name": "get_data",
      "layer": "bronze",
      "sources": [],
      "entry_point": {
        "file": "get_synpuf_files.py",
        "path": "src/CMS SynPUF ETL/scripts/get_synpuf_files.py",
        "parameters": [
          "${var.bronze_subfolder_path}",
          "1"
        ]
      },
      "destination": {
        "type": "volume",
        "subfolder_name": "bronze"
      }
    },
    {
      "name": "etl",
      "layer": "silver",
      "sources": [
        {
          "data_upload_type": "auto",
          "from": "get_data"
        }
      ],
      "entry_point": {
        "file": "CMS_SynPuf_ETL_CDM_v5.py",
        "path": "src/CMS SynPUF ETL/python_etl/CMS_SynPuf_ETL_CDM_v5.py",
        "parameters": [
          "1",
          "BASE_SYNPUF_INPUT_DIRECTORY=${var.bronze_subfolder_path}",
          "BASE_OUTPUT_DIRECTORY=${var.silver_subfolder_path}",
          "BASE_ETL_CONTROL_DIRECTORY=${var.control_subfolder_path}",
          "BASE_OMOP_INPUT_DIRECTORY=${var.omopt_tables_subfolder_path}",
          "SYNPUF_DIR_FORMAT=DE_{0}"
        ]
      },
      "destination": {
        "type": "volume",
        "subfolder_name": "silver"
      }
    },
    {
      "name": "load_to_tables",
      "layer": "gold",
      "sources": [
        {
          "data_upload_type": "auto",
          "from": "etl"
        },
        {
          "data_upload_type": "auto",
          "from": "table_setup"
        }
      ],
      "entry_point": {
        "file": "load_CDMv5_synpuf.sql",
        "path": "src/CMS SynPUF ETL/SQL/load_CDMv5_synpuf.sql",
        "parameters": [
          "data_dir=${var.silver_subfolder_path}"
        ]
      },
      "destination": {
        "type": "tables",
        "catalog": "etl_cms_test",
        "schema": "ohdsi_cdm_test",
        "tables": [
          "concept",
          "vocabulary",
          "domain",
          "concept_class",
          "concept_relationship",
          "relationship",
          "concept_synonym",
          "concept_ancestor",
          "source_to_concept_map",
          "drug_strength",
          "cohort_definition",
          "attribute_definition",
          "cdm_source",
          "person",
          "observation_period",
          "specimen",
          "death",
          "visit_occurrence",
          "procedure_occurrence",
          "drug_exposure",
          "device_exposure",
          "condition_occurrence",
          "measurement_occurrence",
          "note",
          "observation",
          "fact_relationship",
          "location",
          "care_site",
          "provider",
          "payer_plan_period",
          "visit_cost",
          "procedure_cost",
          "drug_cost",
          "device_cost",
          "cohort",
          "cohort_attribute",
          "drug_era",
          "dose_era",
          "condition_era"
        ]
      }
    }
  ],
  "generated": "2026-10-28"
}